{
  "name": "headplane",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "react-router build",
    "dev:app": "HEADPLANE_CONFIG_PATH=./config.example.yaml react-router dev | pino-pretty -c",
    "dev:docker": "docker compose up",
    "dev": "pnpm run --stream /^dev:/",
    "start": "node build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration:*",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "oxlint",
    "format": "oxfmt",
    "release": "node --disable-warning=ExperimentalWarning scripts/release.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/view": "^6.43.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify/react": "^6.0.2",
    "@kubernetes/client-node": "^2.0.0",
    "@lezer/highlight": "^1.2.3",
    "@react-router/node": "^8.3.0",
    "@uiw/react-codemirror": "4.25.11",
    "arktype": "^2.2.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-beta.21",
    "isbot": "5.2.1",
    "jose": "6.2.10",
    "js-yaml": "^5.4.0",
    "lucide-react": "^1.34.0",
    "mime": "^4.1.0",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-codemirror-merge": "4.25.11",
    "react-dom": "19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-router": "^8.3.0",
    "restty": "0.2.6",
    "tailwind-merge": "3.6.0",
    "ulidx": "2.4.1",
    "undici": "8.10.0",
    "valibot": "^1.4.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.0",
    "@shopify/lang-jsonc": "^1.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "1.0.0-beta.21",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitepress": "next",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.2 <25",
    "pnpm": ">=10.4 <11"
  },
  "packageManager": "pnpm@10.4.0",
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    },
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "bufferutil",
      "cpu-features",
      "esbuild",
      "lefthook",
      "protobufjs",
      "ssh2",
      "utf-8-validate"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "@codemirror/state": "6.6.0",
      "mdast-util-to-hast@>=13.0.0 <13.2.1": ">=13.2.1",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "ip-address@<=10.1.0": ">=10.1.1",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6"
    }
  }
}
