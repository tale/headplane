{
  "name": "headplane",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "react-router build",
    "dev:app": "./build.sh --agent --agent-output ./test/hp_agent && HEADPLANE_CONFIG_PATH=./config.example.yaml react-router dev | pino-pretty -c",
    "dev:docker": "docker compose up",
    "dev": "pnpm run --stream /^dev:/",
    "start": "node build/server/index.js",
    "pretypecheck": "cn build -q --content 'app/**/*.{ts,tsx}' --css app/tailwind.css -o app/utils/cn-tables.ts",
    "typecheck": "react-router typegen && tsc",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration:*",
    "harness": "node tests/harness/launch.ts",
    "docs:dev": "cd docs && react-router dev",
    "docs:build": "cd docs && react-router build && node scripts/finish-build.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "release": "node scripts/release.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify/react": "^6.0.2",
    "@kubernetes/client-node": "^2.0.0",
    "@lezer/highlight": "^1.2.5",
    "@react-router/node": "^8.4.0",
    "@uiw/react-codemirror": "4.25.12",
    "arktype": "^2.2.8",
    "cn": "0.5.0",
    "drizzle-orm": "1.0.0-rc.4",
    "isbot": "5.2.2",
    "jose": "6.2.12",
    "js-yaml": "^5.4.3",
    "lucide-react": "^1.56.0",
    "mime": "^4.1.1",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-codemirror-merge": "4.25.12",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-router": "^8.4.0",
    "restty": "0.3.0",
    "ulidx": "2.4.1",
    "undici": "8.11.2",
    "valibot": "^1.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@shopify/lang-jsonc": "^1.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "1.0.0-rc.4",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.5",
    "lefthook": "^2.2.2",
    "next-themes": "^0.4.6",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.64.1",
    "remark-directive": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "testcontainers": "^12.2.1",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24.2 <25",
    "pnpm": ">=10.4 <11"
  },
  "packageManager": "pnpm@10.4.0",
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    },
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "bufferutil",
      "cpu-features",
      "esbuild",
      "lefthook",
      "protobufjs",
      "ssh2",
      "utf-8-validate"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "@codemirror/state": "6.6.0",
      "mdast-util-to-hast@>=13.0.0 <13.2.1": ">=13.2.1",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "ip-address@<=10.1.0": ">=10.1.1",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "ip-address@<=10.5.0": ">=10.5.1",
      "ip-address@>=10.2.0 <=10.5.0": ">=10.5.1",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2"
    }
  }
}
