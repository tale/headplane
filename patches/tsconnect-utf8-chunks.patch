tsconnect: keep UTF-8 sequences whole across SSH output chunks

Upstream converts each chunk of SSH output to a JS string on its own, so a
character split across two reads turns into replacement characters. Those
take extra cells, wrap at the last column and scroll full-screen programs
like btop out of place. Hold back an incomplete sequence for the next write.

Applied to cmd/hp_ssh/wasm_js.go by scripts/sync-tsconnect.sh.

--- a/wasm/wasm_js.go
+++ b/wasm/wasm_js.go
@@ -29,6 +29,7 @@
 	"strings"
 	"syscall/js"
 	"time"
+	"unicode/utf8"
 
 	"golang.org/x/crypto/ssh"
 	"tailscale.com/control/controlclient"
@@ -481,8 +482,8 @@
 		return
 	}
 
-	session.Stdout = termWriter{writeFn}
-	session.Stderr = termWriter{writeFn}
+	session.Stdout = &termWriter{f: writeFn}
+	session.Stderr = &termWriter{f: writeFn}
 
 	setReadFn.Invoke(js.FuncOf(func(this js.Value, args []js.Value) any {
 		input := args[0].String()
@@ -577,10 +578,25 @@
 
 type termWriter struct {
 	f js.Value
+	// The start of a UTF-8 sequence that the next write finishes. Passing it
+	// on alone would turn it into replacement characters.
+	pending []byte
 }
 
-func (w termWriter) Write(p []byte) (n int, err error) {
-	r := bytes.Replace(p, []byte("\n"), []byte("\n\r"), -1)
+func (w *termWriter) Write(p []byte) (n int, err error) {
+	buf := append(w.pending, p...)
+	end := len(buf)
+	for i := len(buf) - 1; i >= 0 && i >= len(buf)-utf8.UTFMax; i-- {
+		if utf8.RuneStart(buf[i]) {
+			if !utf8.FullRune(buf[i:]) {
+				end = i
+			}
+			break
+		}
+	}
+
+	w.pending = bytes.Clone(buf[end:])
+	r := bytes.Replace(buf[:end], []byte("\n"), []byte("\n\r"), -1)
 	w.f.Invoke(string(r))
 	return len(p), nil
 }
